# =========================================================================
# .env.example — copy to .env and fill in real values. NEVER commit .env.
# =========================================================================

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database ---
# Either MONGO_URI or MONGODB_URI is read; prefer MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017/travelhomes
# Optional: override db name without changing the URI
MONGO_DB_NAME=

# --- Auth / JWT ---
# REQUIRED. App will refuse to boot without a strong secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_SECRET_FOR_VERIFY=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# --- Frontend / Admin URLs (used in CORS + email links) ---
FRONTEND_URL=http://localhost:8080
ADMIN_URL=http://localhost:8081
STORE_URL=http://localhost:8080

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Razorpay ---
RAZOR_KEY=
RAZOR_SECRET=

# --- Cashfree ---
# https://merchant.cashfree.com/merchants/pg/developers/api-keys?env=test
# CASHFREE_ENV: TEST (sandbox) or PROD.
CASHFREE_ENV=TEST
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Ops copy of every new booking, and of every compliance take-down.
# Blank = whatever mailbox we send from.
ADMIN_ALERT_EMAIL=

# --- Vehicle compliance sweep ---
# Vehicle listings come off the catalog when their insurance or PUC certificate
# expires, and vendors are warned at 30/15/7/3/1 days out. The sweep runs
# in-process on an interval; there is no cron dependency.
# Set to "false" to turn it off entirely (e.g. on a second app instance that
# would otherwise duplicate the emails).
COMPLIANCE_SWEEP_ENABLED=
# How often the sweep runs. Default 360 (6 hours), floored at 15.
COMPLIANCE_SWEEP_INTERVAL_MINUTES=
# Timezone the expiry DAY is judged in, in minutes east of UTC.
# Default 330 (IST) — a document stays valid through the whole of its stated
# day locally, rather than lapsing at 05:30 IST when UTC rolls over.
COMPLIANCE_TZ_OFFSET_MINUTES=

# --- Twilio (SMS / OTP) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Email (SMTP) ---
# The codebase reads several aliases. Set one consistent set:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Legacy aliases — kept until callers are unified:
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_ENCRYPTION=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SENDER=

# --- Marketing (Facebook) ---
FB_PAGE_ACCESS_TOKEN=

# --- Debug toggles (leave false in production) ---
LOG_AUTH_DEBUG=false
LOG_OTP_DEBUG=false
