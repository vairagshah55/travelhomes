# Copy to apps/web/.env and fill in the real values.
# Vite client-side vars only (must be prefixed with VITE_).

# Backend API — points at the unified server.
VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL_MEDIA=http://localhost:3001
VITE_BACKEND_MEDIA_URL=http://localhost:3001

# OAuth (Google) — used by /auth/google/callback.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Payments (Razorpay).
VITE_RAZOR_KEY=
