{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"],

    // TODO (migration debt): the Frontend codebase was written under a loose
    // TS config — many callbacks (.map((x) => ...), event handlers, etc.)
    // have implicit `any` parameters, and catch blocks use error.message /
    // error.response directly without narrowing. Disabling these two flags
    // here keeps them silent while preserving every other strict check
    // (null safety, strict function types, etc.). Tighten back to true
    // once those call sites have been typed properly. The shared
    // tsconfig.base.json stays strict so future packages don't inherit it.
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
